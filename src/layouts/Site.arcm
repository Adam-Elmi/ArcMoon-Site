# ###################
# The frame of every page: header, the page, footer
# Props: title, description, root ("" on the home page, "../" in docs/), section ("home", "docs", "playground", "packages", "tools" or "versions")
# ###################
${
  import { readFileSync } from "node:fs";

  const { title, description, root = "", section = "home" } = ArcMoon.props();
  const logo = readFileSync(new URL("../logo.svg", import.meta.url), "utf8").replace(/<metadata>[\s\S]*?<\/metadata>/, "");
  const icon = "data:image/svg+xml," + encodeURIComponent(logo);
  // ###################
  // The footer's own copy of the logo: its clipPath ids get a prefix, so they don't repeat the header's
  // ###################
  const footLogo = logo.replace(/id="(\w+)"/g, 'id="foot-$1"').replace(/url\(#(\w+)\)/g, "url(#foot-$1)");
  const year = new Date().getFullYear();
  const getIt = [
    { text: "arcmoon on npm", href: "https://www.npmjs.com/package/arcmoon" },
    { text: "VS Code extension", href: "https://marketplace.visualstudio.com/items?itemName=Adam-Elmi.arcmoon-language" },
    { text: "arcmoon-highlight", href: `${root}tools/highlight.html` },
    { text: "arcmoon-lsp", href: `${root}tools/lsp.html` },
    { text: "GitHub", href: "https://github.com/Adam-Elmi/ArcMoon" }
  ];
  const pageTitle = section === "home" ? "ArcMoon: a template language for web pages" : `${title} · ArcMoon`;
  const links = [
    { id: "home", text: "Home", href: `${root}index.html` },
    { id: "docs", text: "Docs", href: `${root}docs/index.html` },
    { id: "playground", text: "Playground", href: `${root}playground.html` },
    { id: "packages", text: "Packages", href: `${root}packages.html` },
    { id: "tools", text: "Tools", href: `${root}tools.html` },
    { id: "versions", text: "Versions", href: `${root}versions.html` }
  ];
}$

runtime ${
  // ###################
  // Light / dark: the choice is kept in this browser
  // ###################
  const toggle = ArcMoon.ref(ArcMoon.defineRef("theme"));
  toggle.onclick = () => {
    const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem("arcmoon-theme", theme); } catch {}
  };

  // ###################
  // Small screens: the menu button opens the links under the header
  // ###################
  const top = ArcMoon.ref(ArcMoon.defineRef("top"));
  const menu = ArcMoon.ref(ArcMoon.defineRef("menu"));
  const setMenu = (open) => {
    top.dataset.menu = open ? "open" : "closed";
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  menu.onclick = () => setMenu(top.dataset.menu !== "open");
  top.addEventListener("click", (e) => { if (e.target.closest(".links a")) setMenu(false); });
  document.addEventListener("click", (e) => { if (!top.contains(e.target)) setMenu(false); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && top.dataset.menu === "open") { setMenu(false); menu.focus(); }
  });
  matchMedia("(min-width: 721px)").addEventListener("change", (e) => { if (e.matches) setMenu(false); });
}$

[doctype!]
[html = lang: "en"]
[head]
  [meta = charset: "utf-8" !]
  [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
  [title]${ pageTitle }$[end]
  [meta = name: "description", content: ${ description }$ !]
  [link = rel: "icon", href: ${ icon }$ !]
  [script = arcm-raw: true]try{var t=localStorage.getItem("arcmoon-theme");if(!t)t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t}catch(e){}[end]
  [link = rel: "preconnect", href: "https://fonts.googleapis.com" !]
  [link = rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true !]
  [link = rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@300;400&display=optional" !]
  [link = rel: "stylesheet", href: "../styles/site.css" !]
[end]
[body]
[div = class: "page"]
  [header = class: "top", arcm-ref: "top", data-menu: "closed"]
    [div = class: "wrap row"]
      [a = class: "brand", href: ${ `${root}index.html` }$, aria-label: "ArcMoon home"]
        [span = class: "logo"]${ { raw: logo } }$[end]
        [span = class: "word"]ArcMoon[end]
        [span = class: "version"]${ ArcMoon.version }$[end]
      [end]
      [nav = class: "links", id: "site-links", aria-label: "Site"]
        [for-each = ${ links }$, as: "link"]
          [a = href: ${ link.href }$, aria-current: ${ link.id === section ? "page" : null }$]${ link.text }$[end]
        [end]
        [a = class: "github", href: "https://github.com/Adam-Elmi/ArcMoon", aria-label: "ArcMoon on GitHub", title: "GitHub"]
          [svg = viewBox: "0 0 16 16", aria-hidden: "true"][path = fill: "currentColor", d: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" !][end]
          [span = class: "github-text"]GitHub[end]
        [end]
      [end]
      [div = class: "controls"]
        [button = class: "theme", type: "button", arcm-ref: "theme", aria-label: "Switch light and dark"]
          [svg = class: "sun", viewBox: "0 0 16 16", aria-hidden: "true"][circle = cx: "8", cy: "8", r: "3", fill: "none", stroke: "currentColor", stroke-width: "1.5" !][path = d: "M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3", stroke: "currentColor", stroke-width: "1.5" !][end]
          [svg = class: "moon", viewBox: "0 0 16 16", aria-hidden: "true"][path = d: "M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z", fill: "none", stroke: "currentColor", stroke-width: "1.5" !][end]
        [end]
        [button = class: "menu", type: "button", arcm-ref: "menu", aria-controls: "site-links", aria-expanded: "false", aria-label: "Open menu"]
          [svg = class: "bars", viewBox: "0 0 16 16", aria-hidden: "true"][path = d: "M2 4h12M2 8h12M2 12h12", stroke: "currentColor", stroke-width: "1.5", stroke-linecap: "round" !][end]
          [svg = class: "cross", viewBox: "0 0 16 16", aria-hidden: "true"][path = d: "M3.5 3.5l9 9M12.5 3.5l-9 9", stroke: "currentColor", stroke-width: "1.5", stroke-linecap: "round" !][end]
        [end]
      [end]
    [end]
  [end]

  [main][slot!][end]

  [footer = class: "foot"]
    [span = class: "f-moon", aria-hidden: "true"][end]
    [div = class: "wrap f-grid"]
      [div = class: "f-brand"]
        [a = class: "f-name", href: ${ `${root}index.html` }$]
          [span = class: "f-logo"]${ { raw: footLogo } }$[end]
          ArcMoon
        [end]
        [p = class: "f-pitch"]A template language for web pages. Write .arcm, get plain HTML, CSS and JavaScript.[end]
        [p = class: "f-version"]Version ${ ArcMoon.version }$[end]
      [end]
      [nav = class: "f-col", aria-label: "Site"]
        [p = class: "f-head"]Site[end]
        [for-each = ${ links }$, as: "link"][a = href: ${ link.href }$]${ link.text }$[end][end]
      [end]
      [nav = class: "f-col", aria-label: "Get ArcMoon"]
        [p = class: "f-head"]Get it[end]
        [for-each = ${ getIt }$, as: "link"][a = href: ${ link.href }$]${ link.text }$[end][end]
      [end]
    [end]
    [div = class: "wrap f-bottom"]
      [span]© ${ year }$ [a = class: "f-author", href: "https://github.com/Adam-Elmi"]Adam Elmi[end] · MIT License[end]
      [span = class: "made"]Built with ArcMoon, of course.[end]
    [end]
  [end]
[end]
[end]
[end]

[style]
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .top .row {
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    text-decoration: none;
  }
  .logo :global(svg) {
    display: block;
    width: 24px;
    height: 24px;
  }
  .word {
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .version {
    padding: 2px 7px;
    font: 500 11px/1.4 var(--mono);
    color: var(--accent-ink);
    background: var(--accent-soft);
    border-radius: 999px;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--ink);
  }
  .links a[aria-current="page"] {
    font-weight: 500;
  }
  /* ###################
     GitHub: an icon in the bar; icon and word in the phone menu
     ################### */
  .github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .github svg {
    width: 18px;
    height: 18px;
  }
  .github-text {
    display: none;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .theme,
  .menu {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }
  .theme:hover,
  .menu:hover {
    border-color: var(--line-strong);
  }
  .theme svg,
  .menu svg {
    width: 15px;
    height: 15px;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  .menu,
  .cross {
    display: none;
  }
  /* ###################
     Footer: a rose line on top, a crescent rising from the corner over a dot grid,
     the brand and two columns of links, then the copyright line
     ################### */
  .foot {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 48px;
    padding-top: 56px;
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .foot::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .foot::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 18%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: radial-gradient(circle at 100% 100%, black, transparent 55%);
  }
  .f-moon {
    position: absolute;
    z-index: -1;
    right: -120px;
    bottom: -150px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    box-shadow: inset 52px -34px 0 0 var(--accent);
    opacity: 0.12;
    transform: rotate(-12deg);
  }
  .f-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }
  .f-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 20px/1 var(--sans);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .f-logo :global(svg) {
    display: block;
    width: 30px;
    height: 30px;
  }
  .f-pitch {
    max-width: 340px;
    margin: 14px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .f-version {
    display: inline-flex;
    align-items: center;
    margin: 16px 0 0;
    padding: 4px 12px;
    font: 500 12px/1.5 var(--mono);
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .f-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
  }
  .f-head {
    margin: 0 0 4px;
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .f-col a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .f-col a:hover {
    color: var(--accent-ink);
    transform: translateX(3px);
  }
  .f-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 48px;
    padding-top: 20px;
    padding-bottom: 24px;
    font: 13px/1.5 var(--mono);
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  .f-author {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 3px;
  }
  .f-author:hover {
    color: var(--accent-ink);
    text-decoration-color: var(--accent);
  }
  .made {
    color: var(--faint);
  }
  @media (max-width: 720px) {
    .f-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px 24px;
    }
    .f-brand {
      grid-column: 1 / -1;
    }
    .f-moon {
      width: 260px;
      height: 260px;
      right: -110px;
      bottom: -120px;
    }
  }
  /* ###################
     Small screens: links move into a panel under the header
     ################### */
  @media (max-width: 720px) {
    .menu {
      display: grid;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 6px var(--gutter) 14px;
      font-size: 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--ink) 18%, transparent);
    }
    .top[data-menu="open"] .links {
      display: flex;
      animation: drop 0.16s ease-out;
    }
    .links a {
      padding: 12px 4px;
      border-bottom: 1px solid var(--line);
    }
    .links a:last-child {
      border-bottom: 0;
    }
    .github-text {
      display: inline;
    }
    .links a[aria-current="page"] {
      color: var(--accent-ink);
    }
    .top[data-menu="open"] .bars {
      display: none;
    }
    .top[data-menu="open"] .cross {
      display: block;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (max-width: 560px) {
    .version,
    .made {
      display: none;
    }
  }
[end]
