# ###################
# The home page's features: a timeline of src/data/features.json,
# each with its step number, glyph, text, examples and a docs link
# ###################
[import = Code: "./Code.arcm" !]

${
  import features from "../data/features.json";
  const rows = features.map((f, i) => ({ ...f, n: String(i + 1).padStart(2, "0") }));
  const count = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"][rows.length] ?? rows.length;
}$

[section = class: "features", aria-labelledby: "features-title"]
  [header = class: "head"]
    [p = class: "kicker"]Why ArcMoon[end]
    [h2 = id: "features-title"]${ count }$ reasons to write [em].arcm[end][end]
    [p = class: "intro"]Everything below is a real example. The HTML under each one is what ArcMoon builds from it, made while this page was built.[end]
  [end]

  [ol = class: "timeline"]
    [for-each = ${ rows }$, as: "f"]
      [li = class: "feature"]
        [div = class: "rail"][span = class: "n"]${ f.n }$[end][end]
        [div = class: "text"]
          [code = class: "glyph"]${ f.glyph }$[end]
          [h3]${ f.name }$[end]
          [p]${ f.text }$[end]
          [a = href: ${ f.link.href }$]${ f.link.label }$ →[end]
        [end]
        [div = class: "examples"]
          [for-each = ${ f.examples }$, as: "e"]
            [Code = file: ${ e.file }$, lang: ${ e.lang ?? "arcm" }$, output: ${ e.output ?? false }$, title: ${ e.title ?? e.file.split("/").pop() }$ !]
          [end]
        [end]
      [end]
    [end]
  [end]
[end]

[style]
  .features {
    max-width: var(--page);
    margin: 0 auto;
    padding: clamp(64px, 9vw, 112px) var(--gutter) clamp(56px, 8vw, 96px);
  }
  .head {
    max-width: 640px;
    margin: 0 0 clamp(40px, 6vw, 72px) 72px;
  }
  .kicker {
    margin: 0;
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    margin: 14px 0 14px;
    font: 300 clamp(34px, 5vw, 52px)/1.05 var(--serif);
    letter-spacing: -0.02em;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .intro {
    margin: 0;
    font-size: 17px;
    color: var(--muted);
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ###################
     One feature: rail (number on the line) | text | examples
     ################### */
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 5fr) minmax(0, 7fr);
    gap: 0 clamp(24px, 4vw, 48px);
    padding-bottom: clamp(56px, 8vw, 96px);
    animation: rise linear both;
    animation-timeline: view();
    animation-range: entry 0% entry 40%;
  }
  .feature:last-child {
    padding-bottom: 0;
  }
  .rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .feature:not(:last-child) .rail::before,
  .feature:not(:last-child) .rail::after {
    content: "";
    position: absolute;
    top: 52px;
    bottom: calc(-1 * clamp(56px, 8vw, 96px));
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--line);
  }
  .feature:not(:last-child) .rail::after {
    background: var(--accent);
    transform-origin: top;
    animation: fill linear both;
    animation-timeline: view();
    animation-range: contain 0% exit 0%;
  }
  .n {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    font: 500 14px/1 var(--mono);
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .text {
    position: sticky;
    top: 96px;
    align-self: start;
    padding-top: 4px;
  }
  .glyph {
    display: inline-block;
    padding: 4px 10px;
    font: 500 13px/1.3 var(--mono);
    color: var(--accent-ink);
    background: var(--accent-soft);
    border-radius: 6px;
  }
  h3 {
    margin: 14px 0 10px;
    font: 400 28px/1.15 var(--serif);
    letter-spacing: -0.015em;
  }
  .text p {
    margin: 0 0 18px;
    color: var(--muted);
  }
  .text a {
    display: inline-flex;
    padding: 7px 14px;
    font-weight: 500;
    font-size: 14px;
    color: var(--accent-ink);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
  }
  .text a:hover {
    background: var(--accent-soft);
  }

  /* ###################
     Examples look like the hero's window: three dots before the file name
     ################### */
  .examples {
    display: grid;
    gap: 16px;
  }
  .examples > :global(figure) {
    margin: 0;
    border-radius: 12px;
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
  }
  .examples :global(figcaption)::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 30px;
    vertical-align: 1px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 13px 0 0 var(--line-strong), 26px 0 0 var(--line-strong);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(32px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes fill {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @media (max-width: 860px) {
    .head {
      margin-left: 0;
    }
    .feature {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 20px 16px;
    }
    .n {
      width: 40px;
      height: 40px;
      font-size: 12px;
    }
    .examples {
      grid-column: 1 / -1;
    }
    .text {
      position: static;
    }
  }
[end]
