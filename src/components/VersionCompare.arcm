# ###################
# Two releases side by side: A on the left, B on the right, each with its own version list.
# Row by row, each side shows its release's breaking changes, new features, improvements and fixes.
# The two sides can't show the same release: each list disables the version the other side shows.
# Every release's changes are in the HTML; the browser only shows the picked ones.
# The choice is kept in the address (#a=1.2.0&b=2.0.0), so a comparison can be shared
# Props: base (the path to the release pages, default "versions/")
# ###################
${
  import { readFileSync } from "node:fs";
  import { loadReleases, KINDS, pieces } from "../lib/releases.js";

  const { base = "versions/" } = ArcMoon.props();
  const releases = loadReleases();
  export const order = releases.map((r) => r.version);
  const startA = Math.max(0, order.length - 2);
  const startB = order.length - 1;
  const start = { a: startA, b: startB };

  // ###################
  // The logo once per side; its clipPath ids get the side's prefix, so they don't repeat the header's
  // ###################
  const logo = readFileSync(new URL("../logo.svg", import.meta.url), "utf8").replace(/<metadata>[\s\S]*?<\/metadata>/, "");
  const logoFor = (side) => logo.replace(/id="(\w+)"/g, `id="vc-${side}-$1"`).replace(/url\(#(\w+)\)/g, `url(#vc-${side}-$1)`);

  // ###################
  // For each side: the header of every release, and every release's changes of each kind
  // ###################
  const sides = ["a", "b"].map((side) => ({
    side,
    label: side.toUpperCase(),
    logo: { raw: logoFor(side) },
    options: releases.map((r, i) => ({ version: r.version, selected: i === start[side], disabled: i === start[side === "a" ? "b" : "a"] })),
    heads: releases.map((r, v) => ({
      ...r,
      v,
      href: `${base}${r.page}`,
      hide: v === start[side] ? null : "true",
      counts: KINDS.map((k) => {
        const n = r.changes.filter((c) => c.kind === k.id).length;
        return { id: k.id, n, word: n === 1 ? k.one : k.label.toLowerCase(), zero: String(n === 0) };
      })
    }))
  }));
  const rows = KINDS.map((k) => ({
    ...k,
    cells: ["a", "b"].map((side) => {
      const entries = releases.flatMap((r, v) =>
        r.changes.filter((c) => c.kind === k.id).map((c) => ({ ...c, v, href: `${base}${r.page}#${c.id}`, line: pieces(c.text), hide: v === start[side] ? null : "true" }))
      );
      const none = entries.some((e) => !e.hide) ? "true" : null;
      return { side, entries, none };
    })
  }));
}$

runtime ${
  const picks = ArcMoon.refs(ArcMoon.defineRef("vc-pick"));
  const sides = ArcMoon.refs(ArcMoon.defineRef("vc-side"));

  // ###################
  // Show one release on one side: its header, and its changes in every row
  // ###################
  const show = (side, version) => {
    const v = String(order.indexOf(version));
    for (const el of sides.filter((s) => s.dataset.side === side)) {
      let any = false;
      for (const item of el.querySelectorAll("[data-v]")) {
        const hit = item.dataset.v === v;
        item.dataset.hide = String(!hit);
        if (hit && item.tagName === "LI") any = true;
      }
      const none = el.querySelector(".none");
      if (none) none.dataset.hide = String(any);
    }
  };
  // ###################
  // Each list disables the version the other side shows
  // ###################
  const lock = () => {
    for (const p of picks) {
      const other = picks.find((q) => q !== p).value;
      for (const option of p.options) option.disabled = option.value === other;
    }
  };
  const save = () => {
    const [a, b] = ["a", "b"].map((side) => picks.find((p) => p.dataset.side === side).value);
    history.replaceState(null, "", `#a=${a}&b=${b}`);
  };
  const pick = (e) => {
    show(e.target.dataset.side, e.target.value);
    lock();
    save();
  };

  // ###################
  // A shared link (#a=…&b=…), when the page opens or its address changes
  // ###################
  const fromAddress = () => {
    const asked = new URLSearchParams(location.hash.slice(1));
    const a = asked.get("a");
    const b = asked.get("b");
    if (!order.includes(a) || !order.includes(b) || a === b) return;
    for (const [side, version] of [["a", a], ["b", b]]) {
      picks.find((p) => p.dataset.side === side).value = version;
      show(side, version);
    }
    lock();
  };
  fromAddress();
  addEventListener("hashchange", fromAddress);
}$

[div = class: "vc"]
  [div = class: "heads"]
    [for-each = ${ sides }$, as: "s"]
      [div = class: "head", arcm-shared-ref: "vc-side", data-side: ${ s.side }$]
        [label = class: "picker"]
          [span = class: "logo", aria-hidden: "true"]${ s.logo }$[end]
          [select = arcm-shared-ref: "vc-pick", data-side: ${ s.side }$, aria-label: ${ `Version ${s.label}` }$, onchange: runtime ${ pick }$]
            [for-each = ${ s.options }$, as: "o"][option = value: ${ o.version }$, selected: ${ o.selected }$, disabled: ${ o.disabled }$]${ o.version }$[end][end]
          [end]
        [end]
        [for-each = ${ s.heads }$, as: "h"]
          [div = class: "about", data-v: ${ h.v }$, data-hide: ${ h.hide }$]
            [p = class: "date"]Released ${ h.date }$ · [a = href: ${ h.href }$]Details →[end][end]
            [p = class: "summary"]${ h.summary }$[end]
            [ul = class: "counts"]
              [for-each = ${ h.counts }$, as: "c"][li = data-kind: ${ c.id }$, data-zero: ${ c.zero }$][strong]${ c.n }$[end] ${ c.word }$[end][end]
            [end]
          [end]
        [end]
      [end]
    [end]
    [span = class: "vs", aria-hidden: "true"]VS[end]
  [end]

  [for-each = ${ rows }$, as: "row"]
    [section = class: "row", data-kind: ${ row.id }$]
      [h2]${ row.label }$[end]
      [div = class: "cells"]
        [for-each = ${ row.cells }$, as: "cell"]
          [div = class: "cell", arcm-shared-ref: "vc-side", data-side: ${ cell.side }$]
            [ul]
              [for-each = ${ cell.entries }$, as: "e"]
                [li = data-v: ${ e.v }$, data-hide: ${ e.hide }$]
                  [a = href: ${ e.href }$]${ e.title }$[end]
                  [p][for-each = ${ e.line }$, as: "p"][for-each = ${ p.code ? [p.text] : [] }$, as: "c"][code]${ c }$[end][end][for-each = ${ p.code ? [] : [p.text] }$, as: "t"]${ t }$[end][end][end]
                [end]
              [end]
            [end]
            [p = class: "none", data-hide: ${ cell.none }$]None[end]
          [end]
        [end]
      [end]
    [end]
  [end]
[end]

[style]
  .vc {
    --k: var(--pick-6);
    margin-top: 8px;
  }
  [data-kind="breaking"] { --k: var(--pick-1); }
  [data-kind="feature"] { --k: var(--pick-5); }
  [data-kind="improvement"] { --k: var(--pick-2); }
  [data-kind="fix"] { --k: var(--pick-3); }

  /* ###################
     The two heads, A and B, with the VS badge on the line between them
     ################### */
  .heads {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
  }
  .head {
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .head[data-side="a"] {
    background: var(--surface);
  }
  .head[data-side="b"] {
    background: linear-gradient(135deg, var(--accent-soft), var(--bg) 70%);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  }
  .vs {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font: 700 13px/1 var(--mono);
    color: var(--on-accent);
    background: var(--accent);
    border: 4px solid var(--bg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .picker {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .logo :global(svg) {
    width: 24px;
    height: 24px;
  }
  .head[data-side="b"] .logo {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
    box-shadow: 0 6px 16px -10px var(--accent);
  }
  select {
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    font: 600 22px/1.2 var(--mono);
    color: var(--ink);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
  }
  select:hover,
  select:focus-visible {
    border-color: var(--line-strong);
  }
  .date {
    margin: 12px 0 0;
    font: 12px/1.4 var(--mono);
    color: var(--faint);
  }
  .date a {
    color: var(--accent-ink);
    text-decoration: none;
  }
  .summary {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
  }
  .counts li {
    padding: 3px 10px;
    color: var(--k);
    background: color-mix(in srgb, var(--k) 10%, transparent);
    border-radius: 999px;
  }
  .counts li[data-zero="true"] {
    opacity: 0.4;
  }

  /* ###################
     One row per kind: a colored title across both sides, then A | B
     ################### */
  .row {
    margin-top: 32px;
  }
  .row h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    padding-bottom: 8px;
    font: 600 17px/1.3 var(--sans);
    border-bottom: 2px solid var(--k);
  }
  .row h2::before {
    content: "";
    width: 10px;
    height: 10px;
    background: var(--k);
    border-radius: 3px;
  }
  .cells {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) center / 1px 100% no-repeat;
  }
  .cell ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell li {
    padding: 12px 14px;
    background: color-mix(in srgb, var(--k) 5%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--k) 20%, var(--line));
    border-radius: 10px;
  }
  .cell li a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .cell li a:hover {
    color: var(--accent-ink);
  }
  .cell li p {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .none {
    margin: 0;
    padding: 12px 14px;
    font-size: 14px;
    color: var(--faint);
    border: 1px dashed var(--line);
    border-radius: 10px;
  }

  /* stronger than the lists' own display rules */
  .vc [data-hide="true"] {
    display: none;
  }

  /* ###################
     Phones: the same two sides, closer together; one line per change
     ################### */
  @media (max-width: 640px) {
    .heads,
    .cells {
      gap: 16px;
    }
    .head {
      padding: 14px;
    }
    .vs {
      top: 28px;
      width: 36px;
      height: 36px;
      font-size: 11px;
    }
    .logo {
      display: none;
    }
    select {
      padding: 6px 4px;
      font-size: 16px;
    }
    .summary,
    .counts,
    .cell li p {
      display: none;
    }
    .cell li {
      padding: 10px;
      font-size: 14px;
    }
  }
[end]
