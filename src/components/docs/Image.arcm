# ###################
# An image: [Image = src: "…", alt: "…", caption: "…" !]
# width / height: a number (pixels) or any CSS size; default 100% wide, 360px high.
# While it loads, a shimmer of the same size shows; if it fails (or there is no src),
# a placeholder with the alt text. The image fits inside without being cut
# ###################
${
  const { src = "", alt = "", caption = null, width = "100%", height = "360px" } = ArcMoon.props();
  const size = (v) => (typeof v === "number" ? `${v}px` : v);
  export const start = src ? "image is-loading" : "image is-broken";
}$

runtime ${
  import { signal } from "arcmoon/reactive";
  const img = ArcMoon.ref(ArcMoon.defineRef("img"));
  const phase = signal(start);
  const loaded = () => phase("image is-ready");
  const failed = () => phase("image is-broken");
  // ###################
  // Loaded (or failed) before this code ran: from the cache, or an early error
  // ###################
  if (img.getAttribute("src") && img.complete) (img.naturalWidth ? loaded : failed)();
}$

[figure = class: runtime ${ phase() }$, css.width: ${ size(width) }$, --image-height: ${ size(height) }$]
  [div = class: "frame"]
    [img = arcm-ref: "img", src: ${ src || null }$, alt: ${ alt }$, loading: "lazy", onload: runtime ${ loaded }$, onerror: runtime ${ failed }$ !]
    [div = class: "loading", aria-hidden: "true"][span]Loading image…[end][end]
    [div = class: "missing", role: "img", aria-label: ${ alt || "Image not found" }$]
      [svg = viewBox: "0 0 24 24", aria-hidden: "true"][rect = x: "3", y: "3", width: "18", height: "18", rx: "2" !][circle = cx: "9", cy: "9", r: "2" !][path = d: "m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" !][end]
      [span]Image not found[end]
      [small]${ alt }$[end]
    [end]
  [end]
  [figcaption = hidden: ${ !caption }$]${ caption }$[end]
[end]

[style]
  .image {
    max-width: 100%;
    margin: 24px auto;
  }
  .frame {
    position: relative;
    height: var(--image-height);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .is-ready img {
    opacity: 1;
  }
  .loading,
  .missing {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    align-content: center;
    gap: 6px;
    padding: 24px;
    text-align: center;
    color: var(--faint);
    background: var(--sunken);
  }
  .is-loading .loading,
  .is-broken .missing {
    display: grid;
  }

  /* ###################
     Loading: a light sweeping across, and a quiet label
     ################### */
  .loading {
    background: linear-gradient(100deg, var(--sunken) 30%, var(--surface) 50%, var(--sunken) 70%);
    background-size: 300% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
  }
  .loading span {
    font: 500 13px/1 var(--mono);
  }
  @keyframes shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }

  .missing {
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
  }
  .missing svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .missing span {
    font-weight: 500;
    color: var(--muted);
  }
  figcaption {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }
  figcaption[hidden] {
    display: none;
  }
[end]
