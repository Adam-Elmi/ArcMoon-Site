# ###################
# A callout: [Note = type: "tip"]…[end:Note], type "note" (default), "tip" or "warning"
# ###################
${
  const { type = "note" } = ArcMoon.props();
  const label = { note: "Note", tip: "Tip", warning: "Warning" }[type] ?? "Note";
}$
[aside = class: ${ `callout ${type}` }$]
  [strong]${ label }$[end]
  [div][slot!][end]
[end]

[style]
  .callout {
    margin: 20px 0;
    padding: 12px 16px;
    border-left: 3px solid var(--pick-6);
    border-radius: 0 8px 8px 0;
    background: color-mix(in srgb, var(--pick-6) 10%, transparent);
  }
  .tip {
    border-left-color: var(--pick-3);
    background: color-mix(in srgb, var(--pick-3) 10%, transparent);
  }
  .warning {
    border-left-color: var(--pick-1);
    background: color-mix(in srgb, var(--pick-1) 10%, transparent);
  }
  strong {
    display: block;
    margin-bottom: 4px;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  div > :global(:last-child) {
    margin-bottom: 0;
  }
[end]
