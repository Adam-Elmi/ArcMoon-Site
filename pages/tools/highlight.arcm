# ###################
# Tool: arcmoon-highlight
# ###################
[import = Tool: "@/layouts/Tool.arcm" !]
[import = Code: "@/components/Code.arcm" !]
[import = hl: "@/components/docs/Hl.arcm" !]
[import = Text: "@/components/docs/Text.arcm" !]
[import = Title: "@/components/docs/Title.arcm" !]
[import = List: "@/components/docs/List.arcm" !]
[import = Item: "@/components/docs/Item.arcm" !]
[import = Note: "@/components/docs/Note.arcm" !]

[Tool = slug: "highlight"]
  [Text]
    arcmoon-highlight colors ArcMoon code: as HTML in Node.js or the browser, or live in an editor that also
    shows errors. It reads code with ArcMoon\'s own lexer, so it sees it exactly the way ArcMoon does, including the
    JavaScript in [hl = text: "${ }$" !] and the CSS in [hl = text: "[style]" !]. You don\'t need to install [hl = text: "arcmoon" !].
  [end:Text]

  [Title = id: "parts"]What\'s in it[end:Title]
  [List]
    [Item][hl = text: "arcmoon-highlight" !]: [hl = text: "staticHighlight" !], [hl = text: "tokenize" !], [hl = text: "defaultTokens" !], [hl = text: "highlightJs" !], [hl = text: "decorateJs" !].[end:Item]
    [Item][hl = text: "arcmoon-highlight/diagnostics" !]: [hl = text: "diagnose" !].[end:Item]
    [Item][hl = text: "arcmoon-highlight/dynamic" !]: [hl = text: "attachHighlighter" !], the live editor (needs CodeMirror, see below).[end:Item]
  [end:List]

  [Title = id: "highlight"]staticHighlight(src, options)[end:Title]
  [Text]Turns ArcMoon code into highlighted HTML. Every token becomes a [hl = text: "<span>" !] with an inline color from the built-in dark theme:[end:Text]
  [Code = lang: "js", title: "static.js", file: "src/samples/tools/highlight/static.js" !]
  [List]
    [Item]It never throws: half-written code is highlighted up to the problem, and the rest is plain text.[end:Item]
    [Item]Text is escaped, so the result is safe to put in [hl = text: "innerHTML" !].[end:Item]
    [Item]JavaScript in [hl = text: "${ }$" !] and [hl = text: "runtime ${ }$" !], and CSS in [hl = text: "[style]" !], [hl = text: "style:" !], [hl = text: "css." !] and [hl = text: "--" !] props, get their own colors.[end:Item]
  [end:List]

  [Title = size: 3, id: "options"]Choosing colors[end:Title]
  [Text]Each token is drawn by the first of these that answers: [hl = text: "onToken" !], then [hl = text: "tokens[type]" !], then [hl = text: "other" !], then the built-in colors:[end:Text]
  [Code = lang: "js", title: "options.js", file: "src/samples/tools/highlight/options.js" !]
  [List]
    [Item][strong][hl = text: "tokens" !][end]: a style per token type. A style is a color ([hl = text: "\"#ffcc00\"" !]), an object ([hl = text: "{ color, bold, italic }" !]), [hl = text: "{ render }" !] for your own HTML, or [hl = text: "null" !] for plain text.[end:Item]
    [Item][strong][hl = text: "onToken({ prev, current, next })" !][end]: decide for any token, looking at its neighbours. Return HTML, or [hl = text: "undefined" !] to let the next rule decide.[end:Item]
    [Item][strong][hl = text: "other" !][end]: one style for every token type not in [hl = text: "tokens" !].[end:Item]
  [end:List]

  [Title = size: 3, id: "themes"]Colors from your CSS[end:Title]
  [Text]Inline colors can\'t follow light and dark themes. With [hl = text: "classPrefix" !], every token gets a class instead, and your CSS colors it:[end:Text]
  [Code = lang: "js", title: "classes.js", file: "src/samples/tools/highlight/classes.js" !]
  [Code = lang: "css", title: "theme.css", file: "src/samples/tools/highlight/theme.css" !]
  [List]
    [Item]ArcMoon tokens: the prefix plus the token type in lowercase, with dashes: [hl = text: "arcm-identifier" !], [hl = text: "arcm-open-bracket" !], [hl = text: "arcm-end-keyword" !].[end:Item]
    [Item]JavaScript: [hl = text: "arcm-js-keyword" !], [hl = text: "arcm-js-name" !], [hl = text: "arcm-js-call" !], [hl = text: "arcm-js-string" !], [hl = text: "arcm-js-number" !], [hl = text: "arcm-js-operator" !] and more.[end:Item]
    [Item]CSS: [hl = text: "arcm-css-property" !], [hl = text: "arcm-css-class" !], [hl = text: "arcm-css-value" !], [hl = text: "arcm-css-color" !] and more.[end:Item]
    [Item]Errors: [hl = text: "arcm-error" !], plus [hl = text: "arcm-error-arcmoon" !], [hl = text: "arcm-error-javascript" !] or [hl = text: "arcm-error-css" !].[end:Item]
  [end:List]
  [Text]This site colors all its code this way.[end:Text]

  [Title = id: "tokens"]Token types[end:Title]
  [Text][hl = text: "tokenize" !] gives the tokens [hl = text: "staticHighlight" !] colors, and [hl = text: "defaultTokens" !] the built-in colors for each type:[end:Text]
  [Code = lang: "js", title: "tokenize.js", file: "src/samples/tools/highlight/tokenize.js" !]
  [List]
    [Item][strong]Markup:[end] [hl = text: "OPEN_BRACKET" !], [hl = text: "CLOSE_BRACKET" !], [hl = text: "IDENTIFIER" !], [hl = text: "END_KEYWORD" !], [hl = text: "EXCLAMATION_MARK" !], [hl = text: "IMPORT" !], [hl = text: "SLOT" !], [hl = text: "FOR_EACH" !], [hl = text: "TEXT" !], [hl = text: "ESCAPE" !], [hl = text: "WHITESPACE" !].[end:Item]
    [Item][strong]Props:[end] [hl = text: "KEY" !], [hl = text: "EQUAL" !], [hl = text: "COLON" !], [hl = text: "COMMA" !], [hl = text: "STRING" !], [hl = text: "NUMBER" !], [hl = text: "BOOLEAN" !], [hl = text: "WORD" !].[end:Item]
    [Item][strong]Code:[end] [hl = text: "RUNTIME_KEYWORD" !], [hl = text: "LOGIC_OPEN" !], [hl = text: "LOGIC" !], [hl = text: "LOGIC_CLOSE" !].[end:Item]
    [Item][strong]Comments:[end] [hl = text: "COMMENT" !], [hl = text: "COMMENT_BLOCK" !].[end:Item]
    [Item][strong]CSS:[end] [hl = text: "CSS_SELECTOR" !], [hl = text: "CSS_CLASS" !], [hl = text: "CSS_ID" !], [hl = text: "CSS_PSEUDO" !], [hl = text: "CSS_ATTRIBUTE" !], [hl = text: "CSS_AT_RULE" !], [hl = text: "CSS_PROPERTY" !], [hl = text: "CSS_VARIABLE" !], [hl = text: "CSS_VALUE" !], [hl = text: "CSS_NUMBER" !], [hl = text: "CSS_COLOR" !], [hl = text: "CSS_FUNCTION" !], [hl = text: "CSS_STRING" !], [hl = text: "CSS_IMPORTANT" !], [hl = text: "CSS_COMMENT" !], [hl = text: "CSS_PUNCTUATION" !], [hl = text: "CSS_TEXT" !].[end:Item]
  [end:List]

  [Title = id: "js"]JavaScript alone[end:Title]
  [Text][hl = text: "highlightJs(code, { classPrefix })" !] colors plain JavaScript, the same way as inside [hl = text: "${ }$" !]. [hl = text: "decorateJs" !] does the same for editors, as ranges instead of HTML.[end:Text]
  [Code = lang: "js", title: "js.js", file: "src/samples/tools/highlight/js.js" !]

  [Title = id: "errors"]Finding errors: diagnose(src, options)[end:Title]
  [Text]Finds what is wrong in ArcMoon code, without running it, each at its exact spot:[end:Text]
  [List]
    [Item][strong]ArcMoon:[end] syntax errors from ArcMoon\'s lexer and parser, and ArcMoon\'s rules for code, like [hl = text: "export" !] in runtime code or a Node.js module in the browser.[end:Item]
    [Item][strong]JavaScript:[end] every [hl = text: "${ }$" !] is parsed, like the compiler does.[end:Item]
    [Item][strong]CSS:[end] braces, syntax and missing colons are errors; unknown properties and bad values are warnings. Values with [hl = text: "var()" !], [hl = text: "env()" !] or [hl = text: "attr()" !] aren\'t checked.[end:Item]
  [end:List]
  [Code = lang: "js", title: "diagnose.js", file: "src/samples/tools/highlight/diagnose.js" !]
  [List]
    [Item]Each problem has [hl = text: "line" !] and [hl = text: "column" !] (from 1), [hl = text: "from" !] / [hl = text: "to" !] (offsets), the underlined [hl = text: "text" !], [hl = text: "severity" !] ([hl = text: "\"error\"" !] or [hl = text: "\"warning\"" !]), [hl = text: "source" !] and [hl = text: "message" !].[end:Item]
    [Item][hl = text: "rules: false" !] checks syntax only. Rules that need the whole project (like [hl = text: "bundle" !] in the config) are left to the language server.[end:Item]
  [end:List]
  [Text]Pass the list to [hl = text: "staticHighlight" !] as [hl = text: "errors" !], and each problem gets a wavy underline, with its message as a tooltip:[end:Text]
  [Code = lang: "js", title: "errors.js", file: "src/samples/tools/highlight/errors.js" !]

  [Title = id: "editor"]Live editor: attachHighlighter(element, options)[end:Title]
  [Text]A CodeMirror 6 editor that highlights as you type and shows errors with wavy lines and dots by the line numbers. Install CodeMirror next to it:[end:Text]
  [Code = lang: "bash", copy: "always", text: "npm install @codemirror/view @codemirror/state @codemirror/commands @codemirror/lint" !]
  [Code = lang: "js", title: "editor.js", file: "src/samples/tools/highlight/editor.js" !]
  [List]
    [Item]Colors: the same [hl = text: "classPrefix" !], [hl = text: "tokens" !], [hl = text: "other" !] and [hl = text: "onToken" !] as [hl = text: "staticHighlight" !].[end:Item]
    [Item]Errors are checked 250 ms after typing stops. [hl = text: "showErrors: false" !] still checks and calls [hl = text: "onDiagnostics" !] / [hl = text: "onError" !], but draws nothing.[end:Item]
    [Item]Methods: [hl = text: "setValue" !], [hl = text: "getValue" !], [hl = text: "onUpdate" !], [hl = text: "goTo" !] (for example to jump to an error), [hl = text: "destroy" !], and [hl = text: "view" !] for anything else CodeMirror can do.[end:Item]
  [end:List]

  [Title = id: "cdn"]From a CDN[end:Title]
  [Text]Two ready bundles with a global [hl = text: "ArcMoonHighlight" !]. Nothing else to install:[end:Text]
  [Code = lang: "html", title: "index.html", file: "src/samples/tools/highlight/cdn.html" !]
  [Note]
    [Text]The site\'s code examples, the mini playgrounds and the playground all use arcmoon-highlight.[end:Text]
  [end:Note]
[end:Tool]
