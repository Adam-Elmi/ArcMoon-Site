# ###################
# Release 1.1.0: live loops, await, URL imports, and warnings for easy mistakes
# ###################
[import = Release: "@/layouts/Release.arcm" !]
[import = Change: "@/components/release/Change.arcm" !]
[import = Code: "@/components/Code.arcm" !]

[Release = version: "1.1.0", date: "2026-10-22", summary: "Live loops that follow a signal, await in runtime code, imports from a URL, and warnings for easy mistakes. Everything from 1.0 keeps working."]
  [Change = kind: "feature", title: "Live loops", text: "A `[for-each]` whose list is `runtime ${ }$` keeps one row per item in the browser. With `key`, rows stay with their items: added, removed and moved, never redrawn."]
    [Code = text: '
      [for-each = runtime ${ todos() }$, as: "todo", key: "id"]
        [li]runtime ${ todo.title }$[end]
      [end]
    ' !]
  [end:Change]
  [Change = kind: "feature", title: "The first rows of a live loop are in the HTML", text: "When the list starts as a literal or an exported value, its first rows are written at build time and adopted in the browser: no empty list before the script runs."]
  [end:Change]
  [Change = kind: "feature", title: "await in runtime code", text: "A runtime code block can `await` at its top level. Its live values and events attach once its code has run."]
    [Code = text: '
      runtime ${
        import { signal } from "arcmoon/reactive";
        const books = signal(await (await fetch("/books.json")).json());
      }$
    ' !]
  [end:Change]
  [Change = kind: "feature", title: "Imports from a URL", text: "`import x from \"https://…\"` in runtime code stays an import, and the browser loads it. The new `packages` option maps npm names to URLs."]
  [end:Change]
  [Change = kind: "improvement", title: "Warnings for easy mistakes", text: "A signal shown without `()`, non-ASCII text without `<meta charset>`, content in `[img]`, an unknown `arcm-` prop, `[for-each]` over an object, `[doctype!]` after content, props on `[slot]`, and a name only another file's runtime code declares."]
  [end:Change]
  [Change = kind: "improvement", title: "Smaller pages with only event props", text: "A page whose only live values are events no longer ships the signals library: about 2 kB instead of 5 kB."]
  [end:Change]
  [Change = kind: "improvement", title: "Clearer protector message", text: "A template outside the project shows its full path, and the message says when the page itself is outside the folder where arcmoon runs."]
  [end:Change]
  [Change = kind: "fix", title: "[A] is written as <a>", text: "A capitalized HTML name that isn't imported is written in lowercase, as its warning says."]
  [end:Change]
  [Change = kind: "fix", title: "base with -o", text: "With `base: \"/\"`, a build into `dist/blog` links its files under `/blog/`."]
  [end:Change]
  [Change = kind: "fix", title: "The [doctype] error shows where it is", text: "It now has the file, line and column, like every other error."]
  [end:Change]
[end:Release]
