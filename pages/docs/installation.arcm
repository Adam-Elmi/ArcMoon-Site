# ###################
# Docs: Installation
# ###################
[import = Docs: "@/layouts/Docs.arcm" !]
[import = Code: "@/components/Code.arcm" !]
[import = hl: "@/components/docs/Hl.arcm" !]
[import = Text: "@/components/docs/Text.arcm" !]
[import = Title: "@/components/docs/Title.arcm" !]
[import = Link: "@/components/docs/Link.arcm" !]
[import = List: "@/components/docs/List.arcm" !]
[import = Item: "@/components/docs/Item.arcm" !]
[import = Tabs: "@/components/docs/Tabs.arcm" !]
[import = Note: "@/components/docs/Note.arcm" !]

[Docs = slug: "installation"]
  [Title = id: "requirements"]Requirements[end:Title]
  [List]
    [Item][Link = text: "Node.js", href: "https://nodejs.org" !] 22.12 or newer. Check with [hl = text: "node -v" !].[end:Item]
    [Item]npm, pnpm, bun or yarn. npm comes with Node.js.[end:Item]
  [end:List]

  [Title = id: "global"]Install the command[end:Title]
  [Text]Use this to run [hl = text: "arcm" !] from any folder:[end:Text]
  [Tabs = labels: ${ ["npm", "pnpm", "bun", "yarn"] }$]
    [Code = lang: "bash", copy: "always", text: "npm install -g arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "pnpm add -g arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "bun add -g arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "yarn global add arcmoon" !]
  [end:Tabs]
  [Text][hl = text: "arcm" !] and [hl = text: "arcmoon" !] are the same command.[end:Text]

  [Title = id: "project"]Install in one project[end:Title]
  [Text]Use this to keep the version with the project, so everyone who works on it builds with the same one:[end:Text]
  [Tabs = labels: ${ ["npm", "pnpm", "bun", "yarn"] }$]
    [Code = lang: "bash", copy: "always", text: "npm install arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "pnpm add arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "bun add arcmoon" !]
    [Code = lang: "bash", copy: "always", text: "yarn add arcmoon" !]
  [end:Tabs]
  [Text]Then run it with [hl = text: "npx arcm" !], or from a script in [hl = text: "package.json" !]:[end:Text]
  [Code = lang: "json", title: "package.json", text: '
    {
      "scripts": {
        "build": "arcm build pages"
      }
    }
  ' !]

  [Title = id: "verify"]Check that it works[end:Title]
  [Code = lang: "bash", text: ${ `arcm -v\n${ArcMoon.version}` }$ !]
  [Text]Then build a one-line page and print it:[end:Text]
  [Code = lang: "bash", text: '
    echo "[p]Hello[end]" > hello.arcm
    arcm build hello.arcm -p
    <p>Hello</p>
  ' !]
  [Note = type: "warning"]
    [List]
      [Item][hl = text: "arcm: command not found" !]: the global install folder is not in your PATH. Run [hl = text: "npm prefix -g" !] and add its [hl = text: "bin" !] folder, or use [hl = text: "npx arcm" !].[end:Item]
      [Item]Errors right after install: check [hl = text: "node -v" !]. Versions before 22.12 can't run ArcMoon.[end:Item]
    [end:List]
  [end:Note]

  [Title = id: "update"]Update[end:Title]
  [Code = lang: "bash", text: '
    npm install -g arcmoon@latest   # the command
    npm install arcmoon@latest      # in a project
  ' !]

  [Title = id: "editor"]Editor support[end:Title]
  [Text]Install [Link = text: "ArcMoon Language", href: "../tools/lsp.html#vscode" !] for VS Code: highlighting, errors and completion in [hl = text: ".arcm" !] files.[end:Text]
[end:Docs]
