# ###################
# Docs: Comments
# ###################
[import = Docs: "@/layouts/Docs.arcm" !]
[import = Code: "@/components/Code.arcm" !]
[import = Playground: "@/components/Playground.arcm" !]
[import = hl: "@/components/docs/Hl.arcm" !]
[import = Text: "@/components/docs/Text.arcm" !]
[import = Title: "@/components/docs/Title.arcm" !]
[import = Link: "@/components/docs/Link.arcm" !]
[import = List: "@/components/docs/List.arcm" !]
[import = Item: "@/components/docs/Item.arcm" !]

[Docs = slug: "comments"]
  [Title = id: "single-line"]Single-line comments[end:Title]
  [Text][hl = text: "#" !] starts a comment that runs to the end of the line. It can follow code:[end:Text]
  [Code = output: true, text: '
    # the page header
    [h1]Welcome[end] # shown on every page
  ' !]

  [Title = id: "multi-line"]Multi-line comments[end:Title]
  [Text]Everything between [hl = text: "###" !] and [hl = text: "###" !] is a comment, on many lines or inside one:[end:Text]
  [Code = output: true, text: '
    ###
      Draft section:
      not ready yet
    ###
    [p]Ready ### and this is hidden ### now[end]
  ' !]

  [Title = id: "props"]Between props[end:Title]
  [Text]A prop list on several lines can have comments too:[end:Text]
  [Code = output: true, text: '
    [img =
      src: "logo.svg",   # 64 × 64
      alt: "Logo"
    !]
  ' !]

  [Title = id: "not-comments"]Where \# is not a comment[end:Title]
  [List]
    [Item]Inside quotes: [hl = text: "[a = href: \"/page#top\"]" !].[end:Item]
    [Item]Inside [hl = text: "${ }$" !]: it's JavaScript, so use [hl = text: "//" !] and [hl = text: "/* */" !].[end:Item]
    [Item]Inside [hl = text: "[style]" !]: it's CSS, so [hl = text: "#888" !] is a color and comments are [hl = text: "/* */" !].[end:Item]
    [Item]Inside a block with [hl = text: "arcm-raw: true" !].[end:Item]
  [end:List]
  [Code = output: true, pretty: false, file: "src/samples/comments/not-comments.arcm" !]

  [Title = id: "escape"]Writing \# in text[end:Title]
  [Text]In text, write [hl = text: "\\#" !]. Try it: remove the backslash and press Run:[end:Text]
  [Playground = title: "index.arcm", text: '
    [p]Issue \#42 is fixed[end]
  ' !]
  [Text]Without it, the rest of the line is a comment, and ArcMoon says so:[end:Text]
  [Code = lang: "log", text: '
    ✗ [p] opened at 1:1 is missing [end]. The "#" on line 1 starts a comment, which hides the rest of that line, including its [end]. For the character itself, write \#
  ' !]

  [Title = id: "keep"]Keeping comments in the HTML[end:Title]
  [Text]By default, ArcMoon leaves comments out of the HTML. To keep them as HTML comments ([hl = text: "<!-- -->", selectColor: 1 !]), set [hl = text: "removeComments" !] to [hl = text: "false" !] in [hl = text: "arcmoon.config.js" !]:[end:Text]
  [Code = lang: "js", title: "arcmoon.config.js", text: '
    export default {
      removeComments: false
    };
  ' !]
  [Text]Then [hl = text: "arcm build" !] turns every [hl = text: "#" !] and [hl = text: "###" !] comment into an HTML comment, in the same place:[end:Text]
  [Code = title: "page.arcm", file: "src/samples/comments/keep.arcm" !]
  [Code = lang: "html", title: "HTML ArcMoon builds", text: '
    <!-- Page header-->
    <h1>Welcome</h1> <!-- shown on every page-->
    <!--
      License: MIT
    -->
    <p>Hello</p>
  ' !]
  [List]
    [Item]It applies to every page built with that config.[end:Item]
    [Item]From JavaScript, pass the same option: [hl = text: "new ArcMoon({ src, removeComments: false })" !].[end:Item]
    [Item]Comments in [hl = text: "${ }$" !] (JavaScript) and [hl = text: "[style]" !] (CSS) are never written to the HTML.[end:Item]
    [Item]Useful for notes that should ship with the page, like a license.[end:Item]
  [end:List]
[end:Docs]
